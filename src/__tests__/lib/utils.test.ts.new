import { cn } from '@/lib/utils';

describe('cn utility function', () => {
  it('merges class names correctly', () => {
    const result = cn('class1', 'class2');
    expect(result).toBe('class1 class2');
  });

  it('handles conditional classes correctly', () => {
    const result = cn('base', { 'conditional': true, 'not-included': false });
    expect(result).toBe('base conditional');
  });

  it('handles arrays of class names', () => {
    const result = cn('base', ['array1', 'array2']);
    expect(result).toBe('base array1 array2');
  });

  it('handles nested arrays and objects', () => {
    const result = cn(
      'base',
      ['nested1', { 'nested-conditional': true }],
      { 'outer-conditional': true }
    );
    expect(result).toBe('base nested1 nested-conditional outer-conditional');
  });

  it('handles undefined and null values', () => {
    const result = cn('base', undefined, null, 'valid');
    expect(result).toBe('base valid');
  });

  it('handles empty strings', () => {
    const result = cn('base', '', 'valid');
    expect(result).toBe('base valid');
  });

  it('handles complex tailwind class combinations', () => {
    const result = cn(
      'flex items-center',
      { 'p-4': true, 'rounded-lg': true, 'bg-blue-500': false, 'bg-red-500': true }
    );
    expect(result).toBe('flex items-center p-4 rounded-lg bg-red-500');
  });
});
